{
  "_about": "Sources for --sitrep. Add or change sources in sitrep_sources.local.json (git-ignored) instead of editing this file; a local entry with an existing id overrides only the fields it names, e.g. {\"id\": \"github_repos\", \"enabled\": false}. kind 'builtin' uses a parser shipped with the tool; 'link' only points at a page (title and date); 'json' reads named fields by dotted path. path says how the fact reached us; trust says whether the source is the authority for what it states (primary) or a pointer to go and read (lead). 'ecosystems' names the OSV ecosystems a source speaks for, so the report can show where the warehouse has records no source covers. 'must_mention' makes a link source count as found only if the page names the CVE. The config is the allow-list: https only, no private or local hosts.",
  "sources": [
    {"id": "osv", "label": "OSV", "kind": "builtin", "parser": "osv_cve", "url": "https://api.osv.dev/v1/vulns/{cve}", "path": "osv", "trust": "primary", "profiles": ["core"]},
    {"id": "cve_org", "label": "cve.org", "kind": "builtin", "parser": "cve_org", "url": "https://cveawg.mitre.org/api/cve/{cve}", "path": "upstream", "trust": "primary", "profiles": ["core"]},
    {"id": "nvd", "label": "NVD", "kind": "builtin", "parser": "nvd", "url": "https://services.nvd.nist.gov/rest/json/cves/2.0?cveId={cve}", "path": "records", "trust": "primary", "profiles": ["core"], "min_interval": 6, "token_env": "NVD_API_KEY", "token_header": "apiKey", "token_prefix": ""},
    {"id": "github_advisories", "label": "GitHub Advisories", "kind": "builtin", "parser": "github_advisories", "url": "https://api.github.com/advisories?cve_id={cve}", "path": "registry", "trust": "primary", "profiles": ["core"], "token_env": "GITHUB_TOKEN"},
    {"id": "redhat", "label": "Red Hat", "kind": "builtin", "parser": "redhat", "url": "https://access.redhat.com/hydra/rest/securitydata/cve/{cve}.json", "path": "distro", "trust": "primary", "profiles": ["core"], "ecosystems": ["Red Hat"]},
    {"id": "ubuntu", "label": "Ubuntu", "kind": "builtin", "parser": "ubuntu", "url": "https://ubuntu.com/security/cves/{cve}.json", "path": "distro", "trust": "primary", "profiles": ["core"], "ecosystems": ["Ubuntu"]},
    {"id": "debian", "label": "Debian", "kind": "builtin", "parser": "debian", "url": "https://security-tracker.debian.org/tracker/{cve}", "path": "distro", "trust": "primary", "profiles": ["core"], "ecosystems": ["Debian"]},
    {"id": "arch", "label": "Arch Linux", "kind": "builtin", "parser": "arch", "url": "https://security.archlinux.org/{cve}.json", "path": "distro", "trust": "primary", "profiles": ["core"], "ecosystems": ["Arch Linux"]},
    {"id": "epss", "label": "FIRST EPSS", "kind": "builtin", "parser": "epss", "url": "https://api.first.org/data/v1/epss?cve={cve}&scope=time-series", "path": "exploitation", "trust": "primary", "profiles": ["core"]},
    {"id": "kev", "label": "CISA KEV", "kind": "builtin", "parser": "kev", "url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json", "path": "exploitation", "trust": "primary", "profiles": ["core"], "max_bytes": 15000000},
    {"id": "github_repos", "label": "GitHub repositories", "kind": "builtin", "parser": "github_repos", "url": "https://api.github.com/search/repositories?q={cve}&per_page=5", "path": "exploitation", "trust": "lead", "profiles": ["core"], "min_interval": 6.5, "token_env": "GITHUB_TOKEN", "watch_every": 3},
    {"id": "github_oldest", "label": "GitHub (oldest activity)", "kind": "builtin", "parser": "github_oldest", "url": "https://api.github.com/search/repositories?q={cve}&sort=updated&order=asc&per_page=5", "path": "exploitation", "trust": "lead", "profiles": ["core"], "min_interval": 6.5, "token_env": "GITHUB_TOKEN", "watch_every": 3},
    {"id": "suse", "label": "SUSE", "kind": "link", "url": "https://www.suse.com/security/cve/{cve}.html", "path": "distro", "trust": "lead", "profiles": ["extra"], "must_mention": true, "ecosystems": ["SUSE", "openSUSE"], "watch_every": 3},
    {"id": "amazon", "label": "Amazon Linux", "kind": "link", "url": "https://explore.alas.aws.amazon.com/{cve}.html", "path": "distro", "trust": "lead", "profiles": ["extra"], "must_mention": true, "ecosystems": ["Amazon Linux"], "watch_every": 3},
    {"id": "oracle", "label": "Oracle Linux", "kind": "link", "url": "https://linux.oracle.com/cve/{cve}.html", "path": "distro", "trust": "lead", "profiles": ["extra"], "must_mention": true, "ecosystems": ["Oracle Linux"]}
  ],
  "follow_hosts": {
    "www.openwall.com": {"label": "oss-security", "path": "community", "watch_every": 3},
    "www.php.net": {"label": "php.net", "path": "upstream"}
  }
